#!/usr/bin/env bash
set -euo pipefail
bash scripts/scan-secrets.sh
if node -e 'process.exit(Number(process.versions.node.split(".")[0])>=24?0:1)' 2>/dev/null; then
 npm test
 npm run typecheck
 npm audit --audit-level=moderate
else
 command -v docker >/dev/null || { echo "Node 24 or Docker is required for validated pushes"; exit 1; }
 # Only committed source enters the container; production .env/data are never mounted.
 snapshot=$(mktemp -d)
 trap 'rm -rf -- "$snapshot"' EXIT
 git archive HEAD | tar -x -C "$snapshot"
 docker run --rm --memory=1024m --user "$(id -u):$(id -g)" -e HOME=/tmp -e NEXT_TELEMETRY_DISABLED=1 -e RESEND_API_KEY= \
  -v "$snapshot:/app" -w /app node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 \
  sh -c 'npm ci && npm test && npm run typecheck && npm audit --audit-level=moderate'
fi
