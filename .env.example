# Never reuse values or database volumes from another installation.
COMPOSE_PROJECT_NAME=penge
POSTGRES_PASSWORD=generate-a-random-64-character-hex-value
BETTER_AUTH_SECRET=generate-a-different-random-64-character-hex-value
BETTER_AUTH_URL=http://localhost:3000
# Keep the listener local; put a trusted HTTPS reverse proxy in front for remote access.
HOST_BIND=127.0.0.1
HOST_PORT=3000
# Tools outside Compose only. Compose constructs this itself.
DATABASE_URL=postgresql://penge:your-postgres-password@db:5432/penge
# Optional: configure one delivery provider and a verified sender. Never commit these values.
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM=
# Optional operator credit; public UI values are applied when building the image.
SERVICE_PROVIDER_NAME=Penge
SERVICE_PROVIDER_URL=
NEXT_PUBLIC_SERVICE_PROVIDER_NAME=Penge
NEXT_PUBLIC_SERVICE_PROVIDER_URL=
# Public age recipient only; never put the private age identity in this file.
BACKUP_RECIPIENT=
BACKUP_RETENTION_DAYS=30
BACKUP_TOOLS_IMAGE=penge-backup-tools
